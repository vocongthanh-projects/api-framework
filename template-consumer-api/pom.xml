<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>vn.ots.qc.consumer</groupId>
    <artifactId>api-consumer-tests</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>API Consumer Test Template</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <api.framework.version>1.0.1-SNAPSHOT</api.framework.version>
        <testng.version>7.12.0</testng.version>
        <compiler.version>3.15.0</compiler.version>
        <surefire.version>3.5.6</surefire.version>
        <commons-csv.version>1.14.1</commons-csv.version>
        <testng.excluded.groups>database</testng.excluded.groups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>vn.ots.qc</groupId>
            <artifactId>framework-testng</artifactId>
            <version>${api.framework.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>vn.ots.qc</groupId>
            <artifactId>framework-http-restassured</artifactId>
            <version>${api.framework.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.18</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>database-tests</id>
            <properties>
                <testng.excluded.groups></testng.excluded.groups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${surefire.version}</version>
                        <configuration>
                            <groups>database</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>gitlab-registry</id>
            <activation>
                <property><name>api.framework.repository.url</name></property>
            </activation>
            <repositories>
                <repository>
                    <id>api-framework-registry</id>
                    <url>${api.framework.repository.url}</url>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.version}</version>
                <configuration><release>${maven.compiler.release}</release><parameters>true</parameters></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                    <excludedGroups>${testng.excluded.groups}</excludedGroups>
                    <systemPropertyVariables>
                        <api.trace.dir>${project.build.directory}/api-traces</api.trace.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
